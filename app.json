{
  "expo": {
    "name": "Cue",
    "slug": "cue",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "cue",
    "primaryLanguage": "en",
    "description": "Live transcription and recall for conversations. Cue listens, keeps the thread, and tells you what was said and what you agreed to.",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wukoric.cue",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Cue uses the microphone to transcribe the conversation you are in.",
        "NSSpeechRecognitionUsageDescription": "Cue turns what it hears into text so you can read and search the conversation afterwards."
      }
    },
    "android": {
      "package": "com.wukoric.cue",
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1F6FEB"
      }
    },
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Cue uses the microphone to transcribe the conversation you are in.",
          "speechRecognitionPermission": "Cue turns what it hears into text so you can read and search the conversation afterwards.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-quick-actions",
        {
          "androidIcons": {
            "listen_icon": {
              "foregroundImage": "./assets/adaptive-icon.png",
              "backgroundColor": "#1F6FEB"
            }
          }
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Cue",
              "label": "Cue \u2014 Listen",
              "description": "One tap to start transcribing, and what Cue heard last.",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/icon.png",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#10141A"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}